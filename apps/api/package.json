{
  "name": "@coaching/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/run.ts",
    "seed:synthetic": "tsx --env-file-if-exists=../../.env src/seed/isolated.ts",
    "lab:create": "tsx --env-file-if-exists=../../.env src/seed/lab-run.ts",
    "import:plan": "tsx --env-file-if-exists=../../.env src/cli/import-plan.ts",
    "pilot:check": "tsx --env-file-if-exists=../../.env src/cli/pilot-check.ts",
    "import:hevy": "tsx --env-file-if-exists=../../.env src/cli/import-hevy.ts",
    "replay": "tsx --env-file-if-exists=../../.env src/cli/replay.ts",
    "db:copy": "tsx --env-file-if-exists=../../.env scripts/copy-db.ts",
    "db:embed": "node scripts/embed-migrations.mjs",
    "prebuild": "node scripts/embed-migrations.mjs"
  },
  "dependencies": {
    "@coaching/contracts": "*",
    "@coaching/engine": "*",
    "@fastify/cors": "^10.0.2",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
}
